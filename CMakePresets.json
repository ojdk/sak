{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "trace": { "mode": "off" },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      }
    },
    {
      "name": "ninja-generator",
      "hidden": true,
      "generator": "Ninja"
    },
    {
      "name": "msvc-compiler",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "debug",
      "inherits": [ "base", "ninja-generator", "msvc-compiler" ],
      "displayName": "Debug Configuration",
      "description": "Configure for Debug build using vcpkg and Visual Studio compiler (x64)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-DWINDOWS /EHsc /utf-8 /W3",
        "CMAKE_C_FLAGS": "-DWINDOWS"
      }
    },
    {
      "name": "relwithdebinfo",
      "inherits": [ "base", "ninja-generator", "msvc-compiler" ],
      "displayName": "RelWithDebInfo Configuration",
      "description": "Configure for RelWithDebInfo build using vcpkg and Visual Studio compiler (x64)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-DWINDOWS",
        "CMAKE_CXX_FLAGS": "-DWINDOWS"
      }
    },
    {
      "name": "debug-linux",
      "displayName": "debug on wsl",
      "description": "Configure for debug build using vcpkg and Ubuntu / g++  (x64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_C_FLAGS": "-pedantic -Wall",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-pedantic -Wall",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      },
      "environment": {
        "VCPKG_ROOT": "~/.vcpkg"

      }
    },
    {
      "name": "debug-linux-clang",
      "displayName": "debug on wsl clang",
      "description": "Configure for debug build using vcpkg and Ubuntu / Clang  (x64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_FLAGS": "-pedantic -Wall",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-pedantic -Wall",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      },
      "environment": {
        "VCPKG_ROOT": "~/.vcpkg"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "description": "Build Debug configuration",
      "targets": [
        "all"
      ]
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "description": "Build RelWithDebInfo configuration",
      "targets": [
        "all"
      ]
    }
  ]
}