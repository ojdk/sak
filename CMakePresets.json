{
    "version": 8,
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug Configuration",
            "description": "Configure for Debug build using vcpkg and Visual Studio compiler (x64)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/debug",
            "architecture": {
                "value": "x64"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/debug",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo Configuration",
            "description": "Configure for RelWithDebInfo build using vcpkg and Visual Studio compiler (x64)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/relwithdebinfo",
            "architecture": {
                "value": "x64"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/relwithdebinfo",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "description": "Build Debug configuration",
            "targets": [
                "all"
            ]
        },
        {
            "name": "relwithdebinfo",
            "configurePreset": "relwithdebinfo",
            "description": "Build RelWithDebInfo configuration",
            "targets": [
                "all"
            ]
        }
    ]
}